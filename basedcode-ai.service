# Copy to /etc/systemd/system/basedcode-ai.service
# Edit User, WorkingDirectory, and ExecStart paths to match your setup
[Unit]
Description=BasedCode AI UI
After=network.target

[Service]
Type=simple
# CHANGE THESE to match your user and install path:
User=YOURUSER
WorkingDirectory=/home/YOURUSER/basedcode-ai
ExecStart=/home/YOURUSER/basedcode-ai/venv/bin/uvicorn app:app --port 7000 --host 0.0.0.0
Restart=always
RestartSec=3
EnvironmentFile=-/home/YOURUSER/basedcode-ai/.env

[Install]
WantedBy=multi-user.target
