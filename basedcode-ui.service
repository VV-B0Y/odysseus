# Copy to /etc/systemd/system/basedcode-ui.service
# Edit User, WorkingDirectory, and ExecStart paths to match your setup
[Unit]
Description=Based code UI
After=network.target

[Service]
Type=simple
# CHANGE THESE to match your user and install path:
User=YOURUSER
WorkingDirectory=/home/YOURUSER/BasedCode
ExecStart=/home/YOURUSER/BasedCode/venv/bin/uvicorn app:app --port 7000 --host 0.0.0.0
Restart=always
RestartSec=3
EnvironmentFile=-/home/YOURUSER/BasedCode/.env

[Install]
WantedBy=multi-user.target
